# ISO files
*.iso

# Packer
packer/packer_cache/
packer/output-*/

# Vagrant
.vagrant/

build/

# Custom provision scripts (user-specific, not tracked)
packer/custom-provision/*
!packer/custom-provision/.gitkeep
.claude/worktrees/

# Generated Packer seed files (build-only SSH keypair + rendered user-data)
packer/seed/id_ed25519
packer/seed/id_ed25519.pub
packer/seed/user-data

# Go CLI build output
/cli/bin/

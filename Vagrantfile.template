# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrantfile for the ai-sandbox warm template VM.
# Used only by "ai-sandbox.sh warmup" to create the base VM that all
# sandbox clones are forked from. Not used directly for sandbox sessions.
#
# Optional env vars:
#   AI_SANDBOX_MEMORY   — VM memory in MB (default: 4096)
#   AI_SANDBOX_CPUS     — VM CPU count (default: 4)

vm_memory = ENV.fetch("AI_SANDBOX_MEMORY", "4096")
vm_cpus   = ENV.fetch("AI_SANDBOX_CPUS", "4")

Vagrant.configure("2") do |config|
  config.vm.box = "debian13"
  config.vm.box_check_update = false

  config.ssh.username = "rodrigo"
  config.ssh.password = "rodrigo"

  config.vm.network "forwarded_port", guest: 22, host: 2222, id: "ssh", auto_correct: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "ai-sandbox-warm"
    vb.linked_clone = true
    vb.memory = vm_memory
    vb.cpus = vm_cpus.to_i
    vb.gui = false
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
    vb.customize ["modifyvm", :id, "--vram", "16"]
  end
end
